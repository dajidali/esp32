#include <Wire.h>
#define SDA_PIN 10
#define SCL_PIN 8
#define SHUNT_RES 0.10F
#define INA226_ADDR 0x40

#define REG_CONFIG      0x00
#define REG_SHUNT_V     0x01
#define REG_BUS_V       0x02

uint16_t readReg(uint8_t reg) {
  Wire.beginTransmission(INA226_ADDR);
  Wire.write(reg);
  Wire.endTransmission();
  Wire.requestFrom(INA226_ADDR, 2);
  uint16_t val = (Wire.read() << 8) | Wire.read();
  return val;
}
void writeReg(uint8_t reg, uint16_t val) {
  Wire.beginTransmission(INA226_ADDR);
  Wire.write(reg);
  Wire.write(val >> 8);
  Wire.write(val & 0xFF);
  Wire.endTransmission();
}

void setup() {
  Serial.begin(115200);
  Wire.setPins(SDA_PIN, SCL_PIN);
  Wire.begin();
  delay(500);
  // 16次平均，连续采样
  writeReg(REG_CONFIG, 0x4727);
  Serial.println("Vbus(V)\tI(mA)\tP(mW)");
}

void loop() {
  int16_t shuntRaw = (int16_t)readReg(REG_SHUNT_V);
  float shuntVolt = shuntRaw * 2.5e-6F;   // LSB = 2.5 uV
  float currentA = shuntVolt / SHUNT_RES;
  float currentmA = currentA * 1000.0F;

  uint16_t busRaw = readReg(REG_BUS_V);
  float busV = busRaw * 1.25e-3F;         // LSB = 1.25 mV

  float powerW = busV * currentA;
  float powermW = powerW * 1000.0F;

  Serial.printf("%.2f\t%.1f\t%.1f\n", busV, currentmA, powermW);
  delay(500);
}

